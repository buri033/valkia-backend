{
  "name": "valkia-backend",
  "version": "1.0.0",
  "description": "API REST para Valkia Coffee - Arquitectura en 4 capas con TypeScript, Prisma y PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc && prisma generate",
    "start": "node dist/index.js",
    "test": "ts-node src/tests/auth-middlewares.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node-dev src/infrastructure/prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node-dev src/infrastructure/prisma/seed.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "clean-architecture",
    "postgresql",
    "jwt",
    "valkia-coffee"
  ],
  "author": "buri033",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
